{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Chase Family Edition Question",
  "description": "M3 question format. correctAnswer is a zero-based index into answers.",
  "type": "object",
  "required": [
    "id",
    "category",
    "difficulty",
    "question",
    "answers",
    "correctAnswer"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string",
      "minLength": 1
    },
    "difficulty": {
      "enum": [
        "junior",
        "family",
        "challenge"
      ]
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "answers": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "correctAnswer": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "explanation": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}